{
  "name": "@claudeworld/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClaudeWorld TypeScript backend (Bun + Claude Agent SDK)",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "bun test src/tests",
    "pilot": "bun src/scripts/pilot-turn.ts",
    "migration-new": "drizzle-kit generate",
    "migration-check": "bun src/scripts/check-migrations.ts",
    "verify-schema": "bun src/scripts/verify-schema.ts",
    "smoke": "bun src/scripts/smoke-app.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@modelcontextprotocol/server": "2.0.0",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.13.3",
    "jose": "^6.2.9",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "bun-types": "^1.4.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^10.1.0",
    "globals": "^17.3.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.54.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}

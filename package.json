{
  "name": "claudeworld",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ClaudeWorld - a turn-based text adventure run by collaborating Claude agents",
  "workspaces": [
    "backend-ts",
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --filter '@claudeworld/backend' dev",
    "dev:frontend": "bun run --filter '@claudeworld/frontend' dev",
    "build": "bun run --filter '@claudeworld/frontend' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "test:backend": "bun run --filter '@claudeworld/backend' test",
    "test:frontend": "bun run --filter '@claudeworld/frontend' test",
    "migration-check": "bun run --filter '@claudeworld/backend' migration-check",
    "smoke": "bun run --filter '@claudeworld/backend' smoke"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}

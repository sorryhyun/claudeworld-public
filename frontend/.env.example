# Backend API URL — OPTIONAL, and normally left unset.
#
# Unset means same-origin: the app calls /worlds, /auth, ... relative to the
# page it was served from. That is what both supported run modes give you:
#
#   make dev     Vite on :5173 proxies the API prefixes to the backend on :8000
#   make serve   the backend on :8000 serves the built frontend itself
#
# Set it only for a split deployment, where the frontend and the backend really
# are on different origins — e.g. the app on Vercel and the backend behind a
# Cloudflare tunnel:
#
# VITE_API_BASE_URL=https://your-tunnel-domain.trycloudflare.com
#
# Note: authentication is handled via the login screen, not URL credentials.
